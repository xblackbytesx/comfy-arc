# Copy to .env and adjust. Every value here is optional: the defaults shown are
# what entrypoint.sh applies on its own.

# Run as this account so files on the host are not owned by root. Set both to
# whoever owns the data directory (on TrueNAS, the apps user). Leave unset to
# keep the old behaviour of running as root.
# PUID=950
# PGID=950

# Image tag to run, and where data lives on the host.
COMFY_ARC_TAG=latest
COMFY_ARC_DATA=./data
COMFY_ARC_PORT=8188

# Keep a model in VRAM between runs (repeats start at once), or push the
# weights back to system RAM after every run (frees VRAM sooner, holds RAM
# instead, and makes each generation slower).
COMFY_SMART_MEMORY=on

# Release models and cache after this many seconds with an empty queue. This,
# not the setting above, is what gives memory back when you stop working.
# Unset or 0 keeps everything loaded until the container stops.
# COMFY_IDLE_UNLOAD=300
# COMFY_IDLE_POLL=15

# Overlap weight transfers with compute. on, off, or a number of streams.
COMFY_ASYNC_OFFLOAD=on

# Node result cache: classic, none (least RAM, re-runs everything), or lru:N.
COMFY_CACHE=classic

# Hold VRAM back for other software, in GB. RESERVE is ComfyUI's own
# reservation; HEADROOM also counts what other processes are using.
# COMFY_RESERVE_VRAM=2
# COMFY_VRAM_HEADROOM=2

# Let the frontend reach remote API services.
COMFY_API_NODES=on

# Anything else, passed through verbatim.
# COMFY_EXTRA_ARGS=--verbose DEBUG
